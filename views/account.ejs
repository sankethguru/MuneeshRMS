<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="applet-shell">
  <div class="applet-titlebar"><span class="applet-title">My Account</span></div>
  <% if (error) { %><div class="admin-notice err"><%= error %></div><% } %>
  <% if (notice) { %><div class="admin-notice ok"><%= notice %></div><% } %>
  <form class="detail-form" method="POST" action="/account/password">
    <div class="field-grid">
      <div class="field-row"><label class="field-label">Username</label><div class="field-value"><input type="text" value="<%= currentUser.username %>" readonly></div></div>
      <div class="field-row"><label class="field-label">Current Password</label><div class="field-value"><input type="password" name="currentPassword" required></div></div>
      <div class="field-row"><label class="field-label">New Password</label><div class="field-value"><input type="password" name="newPassword" required minlength="8"></div></div>
      <div class="field-row"><label class="field-label">Confirm New Password</label><div class="field-value"><input type="password" name="confirmPassword" required minlength="8"></div></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Change Password</button></div>
  </form>
</div>

<%- include('partials/foot') %>
