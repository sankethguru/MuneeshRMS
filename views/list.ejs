<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="applet-shell">
  <div class="applet-titlebar">
    <span class="applet-title"><%= listTitle %></span>
    <div class="applet-toolbar">
      <% if (canCreate) { %><a class="btn btn-toolbar" href="/<%= entity.key %>/new/form">+ New Record</a><% } %>
      <a class="btn btn-toolbar" href="/admin/<%= entity.key %>/fields">Edit Fields</a>
      <a class="btn btn-toolbar" href="/admin/<%= entity.key %>/trash">Trash</a>
      <a class="btn btn-toolbar" href="/admin/<%= entity.key %>/export.csv" title="Download filtered records as CSV">&#8615; CSV</a>
      <button class="btn btn-toolbar" type="button" onclick="location.reload()">&#8635; Refresh</button>
    </div>
  </div>

  <%
    // Builds a query string carrying forward the CURRENT q/filters/sort
    // state, with the given overrides applied on top — used by every
    // link on this page (sort headers, pagination) so clicking any one
    // of them never silently loses the others.
    function mlListUrl(overrides) {
      var params = new URLSearchParams();
      var effectiveQ = overrides.q !== undefined ? overrides.q : q;
      if (effectiveQ) params.set('q', effectiveQ);
      filterFields.forEach(function(f) {
        var kind = filterKindFor(f);
        if (kind === 'date-range' || kind === 'number-range') {
          if (filterValues[f.name].from) params.set('f_' + f.name + '_from', filterValues[f.name].from);
          if (filterValues[f.name].to) params.set('f_' + f.name + '_to', filterValues[f.name].to);
        } else if (filterValues[f.name]) {
          params.set('f_' + f.name, filterValues[f.name]);
        }
      });
      var effectiveSort = overrides.sort !== undefined ? overrides.sort : sortField;
      var effectiveDir = overrides.dir !== undefined ? overrides.dir : sortDir;
      if (effectiveSort) { params.set('sort', effectiveSort); params.set('dir', effectiveDir || 'asc'); }
      var effectivePage = overrides.page !== undefined ? overrides.page : page;
      if (effectivePage && effectivePage !== 1) params.set('page', effectivePage);
      var qs = params.toString();
      return '/' + entity.key + (qs ? '?' + qs : '');
    }
    function mlSortHeaderUrl(fieldName) {
      var newDir = (sortField === fieldName && sortDir === 'asc') ? 'desc' : 'asc';
      return mlListUrl({ sort: fieldName, dir: newDir, page: 1 });
    }
  %>

  <form class="query-bar" method="GET" action="/<%= entity.key %>">
    <label for="q">Query:</label>
    <input type="text" id="q" name="q" value="<%= q %>" placeholder="Type to filter across visible columns and press Enter&hellip;" autocomplete="off">
    <% if (sortField) { %><input type="hidden" name="sort" value="<%= sortField %>"><input type="hidden" name="dir" value="<%= sortDir %>"><% } %>
    <% if (filterFields.length > 0) { %>
      <button class="btn btn-query" type="button" onclick="mlToggleFilterPanel()">Filter<%= filtersActive ? ' \u25CF' : '' %></button>
    <% } %>
    <button class="btn btn-query" type="submit">Go</button>
    <% if (q || filtersActive || sortField) { %><a class="btn btn-query" href="/<%= entity.key %>?clear=1">Clear</a><% } %>
    <span class="query-count"><%= totalCount %> record<%= totalCount === 1 ? '' : 's' %><%= totalPages > 1 ? ' (page ' + page + ' of ' + totalPages + ')' : '' %></span>

    <% if (filterFields.length > 0) { %>
    <div id="filterPanel" class="filter-panel" style="<%= filtersActive ? '' : 'display:none' %>">
      <% filterFields.forEach(function(f){ %>
        <% var kind = filterKindFor(f); %>
        <div class="filter-control">
          <label><%= f.label %><%= (f.type === 'percent' || f.format === 'percent') ? ' (%)' : '' %></label>
          <% if (kind === 'exact' && f.type === 'bool') { %>
            <select name="f_<%= f.name %>">
              <option value="">All</option>
              <option value="true" <%= filterValues[f.name]==='true' ? 'selected' : '' %>>Yes</option>
              <option value="false" <%= filterValues[f.name]==='false' ? 'selected' : '' %>>No</option>
            </select>
          <% } else if (kind === 'exact' && f.type === 'picklist') { %>
            <select name="f_<%= f.name %>">
              <option value="">All</option>
              <% resolvePicklistOptions(entity, f).forEach(function(opt){ %>
                <option value="<%= opt.key %>" <%= filterValues[f.name]===opt.key ? 'selected' : '' %>><%= opt.label %></option>
              <% }); %>
            </select>
          <% } else if (kind === 'exact' && f.type === 'fk') { %>
            <select name="f_<%= f.name %>">
              <option value="">All</option>
              <% (fkFilterOptions[f.name] || []).forEach(function(opt){ %>
                <option value="<%= opt.value %>" <%= filterValues[f.name]===String(opt.value) ? 'selected' : '' %>><%= opt.label %></option>
              <% }); %>
            </select>
          <% } else if (kind === 'exact') { %>
            <input type="text" name="f_<%= f.name %>" value="<%= filterValues[f.name] %>" placeholder="Exact match&hellip;">
          <% } else if (kind === 'date-range') { %>
            <span class="filter-date-range">
              <input type="date" name="f_<%= f.name %>_from" value="<%= filterValues[f.name].from %>" title="From">
              &ndash;
              <input type="date" name="f_<%= f.name %>_to" value="<%= filterValues[f.name].to %>" title="To">
            </span>
          <% } else if (kind === 'number-range') { %>
            <span class="filter-date-range">
              <input type="number" step="any" name="f_<%= f.name %>_from" value="<%= filterValues[f.name].from %>" title="Min" placeholder="Min" style="width:72px">
              &ndash;
              <input type="number" step="any" name="f_<%= f.name %>_to" value="<%= filterValues[f.name].to %>" title="Max" placeholder="Max" style="width:72px">
            </span>
          <% } %>
        </div>
      <% }); %>
      <button class="btn btn-primary btn-mini" type="submit">Apply Filters</button>
    </div>
    <% } %>
  </form>
  <% if (listState && (listState.q || listState.sort || Object.keys(listState.filters || {}).length)) { %>
    <p class="admin-hint" style="padding: 0 4px 8px;">Remembering your last query/filter/sort on this screen &mdash; use "Clear" above to reset it.</p>
  <% } %>

  <div class="list-table-wrap">
    <table class="list-table" id="mainListTable">
      <thead>
        <tr>
          <% listFields.forEach(function(f){ %>
            <th><a class="sort-header" href="<%= mlSortHeaderUrl(f.name) %>"><%= f.label %><%= sortField === f.name ? (sortDir === 'desc' ? ' \u25BC' : ' \u25B2') : '' %></a></th>
          <% }); %>
          <th class="col-actions">&nbsp;</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
          <tr><td colspan="<%= listFields.length + 1 %>" class="empty-row">No records found. Query specified no matching rows.</td></tr>
        <% } %>
        <% rows.forEach(function(r, i){ %>
          <tr class="data-row <%= i % 2 === 0 ? 'row-even' : 'row-odd' %>" onclick="location.href='/<%= entity.key %>/<%= encodeURIComponent(r[entity.pk]) %>'">
            <% listFields.forEach(function(f, ci){ %>
              <td>
                <% var val = r[f.name]; %>
                <% if (typeof val === 'boolean') { %>
                  <span class="bool-flag <%= val ? 'bool-yes' : 'bool-no' %>"><%= val ? 'Y' : 'N' %></span>
                <% } else if (f.type === 'currency') { %>
                  <span class="currency-val"><%= formatINR(val) %></span>
                <% } else if (f.type === 'percent') { %>
                  <span class="currency-val"><%= formatPercent(val) %></span>
                <% } else if (f.type === 'image') { %>
                  <% if (val) { %><img class="image-thumb-mini" src="/uploads/<%= entity.key %>/<%= f.name %>/<%= val %>" alt=""><% } %>
                <% } else if (f.type === 'date') { %>
                  <%= formatDate(val, false) %>
                <% } else if (f.type === 'timestamp') { %>
                  <%= formatDate(val, true) %>
                <% } else if (f.type === 'formula' || f.type === 'rollup') { %>
                  <%= formatFormulaValue(f, val) %>
                <% } else if (f.type === 'picklist') { %>
                  <% var pLabel = val ? picklistLabel(entity, f, val) : ''; %>
                  <% if (ci === 0) { %><a class="cell-link" href="/<%= entity.key %>/<%= encodeURIComponent(r[entity.pk]) %>"><%= pLabel %></a><% } else { %><%= pLabel %><% } %>
                <% } else if (ci === 0) { %>
                  <a class="cell-link" href="/<%= entity.key %>/<%= encodeURIComponent(r[entity.pk]) %>"><%= val %></a>
                <% } else { %>
                  <%= val %>
                <% } %>
              </td>
            <% }); %>
            <td class="col-actions" onclick="event.stopPropagation()">
              <% if (canDelete) { %>
              <form method="POST" action="/<%= entity.key %>/<%= encodeURIComponent(r[entity.pk]) %>/delete" onsubmit="return confirm('Delete this record permanently?');">
                <button class="btn btn-mini btn-danger" type="submit">Delete</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
      <% if (rows.length > 0 && Object.keys(listTotals).some(function(k){ return listTotals[k].value !== null; })) { %>
      <tfoot>
        <tr class="row-total">
          <% listFields.forEach(function(f, ci){ %>
            <td>
              <% if (ci === 0) { %><strong>Totals</strong><% } %>
              <% var t = listTotals[f.name]; %>
              <% if (t && t.value !== null) { %>
                <% var fnLabel = { sum: 'Sum', avg: 'Avg', max: 'Max', min: 'Min' }[t.fn]; %>
                <strong>
                  <%= fnLabel %>:
                  <% if (f.type === 'currency') { %><%= formatINR(t.value) %>
                  <% } else if (f.type === 'percent') { %><%= formatPercent(t.value) %>
                  <% } else { %><%= (Math.round(t.value * 100) / 100) %>
                  <% } %>
                </strong>
              <% } %>
            </td>
          <% }); %>
          <td class="col-actions">&nbsp;</td>
        </tr>
      </tfoot>
      <% } %>
    </table>
    <% if (totalPages > 1) { %>
      <div class="expand-row-wrap" style="display:flex; gap:8px; align-items:center; justify-content:center;">
        <% if (page > 1) { %><a class="btn btn-mini" href="<%= mlListUrl({ page: page - 1 }) %>">&larr; Previous</a><% } %>
        <span class="admin-hint">Page <%= page %> of <%= totalPages %> (<%= totalCount %> total)</span>
        <% if (page < totalPages) { %><a class="btn btn-mini" href="<%= mlListUrl({ page: page + 1 }) %>">Next &rarr;</a><% } %>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/foot') %>
