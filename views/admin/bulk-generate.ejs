<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('_subnav', { sub: 'bulk-generate' }) %>

<div class="applet-shell">
  <div class="applet-titlebar"><span class="applet-title">Bulk Generate</span></div>

  <% if (error) { %><div class="admin-notice err"><%= error %></div><% } %>
  <% if (notice) { %><div class="admin-notice ok"><%= notice %></div><% } %>

  <p class="admin-help">
    Create records in bulk from a source table &mdash; e.g. generate one invoice per active tenant for a month,
    or one CC Tracker entry per credit card. Profiles are reusable saved configurations; <strong>Run</strong>
    picks a month and generates. Idempotent: if a dedup field is set, existing records are skipped.
  </p>

  <% if (profiles.length) { %>
    <% profiles.forEach(function(p){ %>
      <div class="applet-shell child-applet" style="margin:10px 16px;">
        <div class="applet-titlebar applet-titlebar-child">
          <span class="applet-title"><%= p.label %></span>
          <div class="applet-toolbar">
            <a class="btn btn-toolbar btn-mini" href="/admin/bulk-generate/<%= p.key %>/edit">Edit</a>
            <form method="POST" action="/admin/bulk-generate/<%= p.key %>/delete" onsubmit="return confirm('Delete this profile?');" style="display:inline"><button class="btn btn-toolbar btn-danger btn-mini" type="submit">Delete</button></form>
          </div>
        </div>
        <div style="padding:8px 16px;font-size:12px;color:var(--ink-soft);">
          <strong>Source:</strong> <%= p.sourceTable %><%= p.sourceFilter ? ' WHERE ' + p.sourceFilter : '' %><%= p.sourceSort ? ' ORDER BY ' + p.sourceSort : '' %>
          &rarr; <strong>Target:</strong> <%= p.targetTable %>
          <% if (p.monthField) { %> &middot; Month &rarr; <code><%= p.monthField %></code><% } %>
          <% if (p.dedupField) { %> &middot; Dedup: <code><%= p.dedupField %></code> = source.<code><%= p.dedupSourceField %></code><% } %>
          <% if (p.fieldMappings && p.fieldMappings.length) { %><br>Mappings: <% p.fieldMappings.forEach(function(m,i){ %><%= i ? ', ' : '' %><code><%= m.targetField %></code>&larr;<code><%= m.value %></code><% }); %><% } %>
        </div>
        <form method="POST" action="/admin/bulk-generate/<%= p.key %>/run" style="padding:8px 16px;display:flex;gap:8px;align-items:center;">
          <label style="font-size:12px;">Month: <input type="month" name="month" required></label>
          <button class="btn btn-primary" type="submit">Run</button>
        </form>
      </div>
    <% }); %>
  <% } %>

  <div class="applet-shell child-applet" style="margin:10px 16px;">
    <div class="applet-titlebar applet-titlebar-child"><span class="applet-title">New Profile</span></div>
    <form method="POST" action="/admin/bulk-generate/profile" class="admin-form" style="padding:12px 16px;">
      <label>Profile Name * <input type="text" name="label" required placeholder="e.g. Monthly Invoices"></label>
      <label>Source Table *
        <select name="sourceTable" required><option value="">— choose —</option>
          <% Object.values(entities).forEach(function(e){ %><option value="<%= e.key %>"><%= e.label %></option><% }); %>
        </select>
      </label>
      <label>Source Filter (formula) <input type="text" name="sourceFilter" placeholder='e.g. T_Active = true AND T_MappedTo = "HPCL"'></label>
      <label>Source Sort Field <input type="text" name="sourceSort" placeholder="e.g. T_BillSequence"></label>
      <label>Target Table *
        <select name="targetTable" required><option value="">— choose —</option>
          <% Object.values(entities).forEach(function(e){ %><option value="<%= e.key %>"><%= e.label %></option><% }); %>
        </select>
      </label>
      <label>Month Field (on target) <input type="text" name="monthField" placeholder="e.g. INV_Month"></label>
      <label>Dedup Field (on target) <input type="text" name="dedupField" placeholder="e.g. INV_Tenant"></label>
      <label>Dedup Source Field <input type="text" name="dedupSourceField" placeholder="e.g. T_Client_Code"></label>
      <div class="applet-titlebar applet-titlebar-child" style="margin-top:10px;"><span class="applet-title" style="font-size:12px;">Field Mappings (target &larr; source field or literal)</span></div>
      <div id="mappingsBody">
        <div style="display:flex;gap:8px;margin:4px 0;"><input type="text" name="map_target" placeholder="target field" style="flex:1;"><input type="text" name="map_value" placeholder="source field or literal" style="flex:1;"><button class="btn btn-mini btn-danger" type="button" onclick="this.parentElement.remove()">&times;</button></div>
        <div style="display:flex;gap:8px;margin:4px 0;"><input type="text" name="map_target" placeholder="target field" style="flex:1;"><input type="text" name="map_value" placeholder="source field or literal" style="flex:1;"><button class="btn btn-mini btn-danger" type="button" onclick="this.parentElement.remove()">&times;</button></div>
        <div style="display:flex;gap:8px;margin:4px 0;"><input type="text" name="map_target" placeholder="target field" style="flex:1;"><input type="text" name="map_value" placeholder="source field or literal" style="flex:1;"><button class="btn btn-mini btn-danger" type="button" onclick="this.parentElement.remove()">&times;</button></div>
      </div>
      <button class="btn btn-mini" type="button" onclick="var d=document.createElement('div');d.style='display:flex;gap:8px;margin:4px 0;';d.innerHTML='<input type=text name=map_target placeholder=&quot;target field&quot; style=flex:1><input type=text name=map_value placeholder=&quot;source field or literal&quot; style=flex:1><button class=&quot;btn btn-mini btn-danger&quot; type=button onclick=this.parentElement.remove()>&times;</button>';document.getElementById('mappingsBody').appendChild(d);">+ Add Mapping</button>
      <div style="margin-top:12px;"><button class="btn btn-primary" type="submit">Create Profile</button></div>
    </form>
  </div>
</div>

<%- include('../partials/foot') %>
