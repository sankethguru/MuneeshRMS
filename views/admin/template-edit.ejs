<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('_subnav', { sub: 'templates' }) %>

<div class="applet-shell">
  <div class="applet-titlebar">
    <span class="applet-title">Edit Template: <%= template.label %></span>
    <div class="applet-toolbar">
      <a class="btn btn-toolbar btn-mini" href="/admin/templates">&larr; Back to Template Library</a>
    </div>
  </div>

  <% if (notice) { %><div class="admin-notice ok"><%= notice %></div><% } %>
  <% if (error) { %><div class="admin-notice err"><%= error %></div><% } %>

  <form method="POST" action="/admin/templates/<%= template.key %>">
    <input type="hidden" name="label" value="<%= template.label %>">
    <input type="hidden" name="baseTable" value="<%= template.baseTable %>">

    <div class="applet-titlebar applet-titlebar-child"><span class="applet-title">Layout</span></div>
    <div class="field-grid" style="padding:0 12px;">
      <div class="field-row">
        <label class="field-label">Page Orientation</label>
        <div class="field-value">
          <select name="pageOrientation">
            <option value="portrait" <%= template.pageOrientation !== 'landscape' ? 'selected' : '' %>>Portrait</option>
            <option value="landscape" <%= template.pageOrientation === 'landscape' ? 'selected' : '' %>>Landscape</option>
          </select>
          <p class="admin-hint">Landscape gives more horizontal room per row &mdash; worth it once a table has enough columns that Portrait starts wrapping dates and amounts onto multiple lines.</p>
        </div>
      </div>
    </div>

    <div class="applet-titlebar applet-titlebar-child"><span class="applet-title">Line Items</span></div>
    <p class="admin-help" style="padding:8px 12px;">
      What <code>{{#each LineItems}}...{{/each}}</code> loops over. Leave as "None" and it loops exactly once, over
      <%= baseEntity.label %> itself &mdash; useful until a real line-items table exists.
    </p>
    <div class="field-grid" style="padding:0 12px;">
      <div class="field-row">
        <label class="field-label">Source Table</label>
        <div class="field-value">
          <select name="lineItemsChildTable" id="lineItemsChildTable" onchange="mlUpdateLineItemsFkOptions()">
            <option value="">None &mdash; loops once over <%= baseEntity.label %> itself</option>
            <% childCandidates.forEach(function(c){ %>
              <option value="<%= c.entity.key %>" <%= template.lineItemsChildTable === c.entity.key ? 'selected' : '' %>><%= c.entity.label %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="field-row">
        <label class="field-label">Linking Field</label>
        <div class="field-value">
          <select name="lineItemsFkField" id="lineItemsFkField">
            <option value="">&mdash;</option>
            <% childCandidates.forEach(function(c){ %>
              <% c.fkFields.forEach(function(fk){ %>
                <option value="<%= fk.name %>" data-parent="<%= c.entity.key %>" <%= (template.lineItemsChildTable === c.entity.key && template.lineItemsFkField === fk.name) ? 'selected' : '' %>><%= c.entity.label %>.<%= fk.label %></option>
              <% }); %>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <div class="applet-titlebar applet-titlebar-child"><span class="applet-title">HTML Body</span></div>
    <div style="display:flex; gap:0; align-items:flex-start;">
      <div style="flex:1; min-width:0; position:relative; height:520px;">
        <div id="htmlBodyHighlight" class="editor-highlight-layer" aria-hidden="true"></div>
        <textarea id="htmlBodyEditor" name="htmlBody" class="editor-textarea" spellcheck="false"><%= template.htmlBody %></textarea>
      </div>
      <div style="width:260px; flex-shrink:0; border:1px solid var(--border-dark); border-left:none; height:520px; overflow-y:auto; background:#f8f7f2;">
        <div style="padding:8px 10px; background:#e8e6dc; font-weight:600; font-size:11px; border-bottom:1px solid var(--border-dark);">Click to insert &mdash; <%= baseEntity.label %></div>
        <% baseEntity.fields.filter(function(f){ return f.type !== 'spacer' && f.type !== 'section'; }).forEach(function(f){ %>
          <div class="field-picker-item" onclick="mlInsertMergeTag('{{<%= f.name %>}}')" title="<%= f.name %><%= (f.type==='formula'||f.type==='rollup') ? ' (computed)' : '' %>"><%= f.label %></div>
        <% }); %>
        <% relatedTrees.forEach(function(rel){ %>
          <div style="padding:8px 10px; background:#e8e6dc; font-weight:600; font-size:11px; border-bottom:1px solid var(--border-dark); border-top:1px solid var(--border-dark);">Via <%= rel.fkLabel %> (<%= rel.targetEntity.label %>)</div>
          <% rel.targetEntity.fields.filter(function(f){ return f.type !== 'spacer' && f.type !== 'section'; }).forEach(function(f){ %>
            <div class="field-picker-item" onclick="mlInsertMergeTag('{{<%= rel.fkFieldName %>.<%= f.name %>}}')" title="<%= rel.fkFieldName %>.<%= f.name %>"><%= f.label %></div>
          <% }); %>
        <% }); %>
      </div>
    </div>
    <style>
      /* Syntax highlighting is a genuine overlay trick, not a real code
         editor library: the highlight layer underneath shows the actual
         colored text, while the textarea on top is made text-transparent
         (only its caret stays visible) and keeps handling every bit of
         real editing, selection, and cursor behavior itself, completely
         normally. The two layers MUST share identical font/size/padding/
         line-height/white-space/word-wrap, or the invisible text the
         user is actually typing stops lining up with what they see
         underneath. */
      .editor-highlight-layer, .editor-textarea {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        margin: 0; padding: 10px; box-sizing: border-box;
        font-family: 'Courier New', monospace; font-size: 12px; line-height: 1.5;
        white-space: pre-wrap; word-wrap: break-word; overflow: auto;
        border: 1px solid var(--border-dark);
      }
      .editor-highlight-layer { background: var(--white); color: #2a2a2a; pointer-events: none; }
      .editor-textarea { background: transparent; color: transparent; caret-color: #000; resize: none; }
      .editor-textarea::selection { background: rgba(60, 120, 220, 0.35); }
      .merge-tag-highlight { background: #fff2b2; color: #7a5b00; border-radius: 2px; padding: 0 1px; }
      .merge-tag-each { background: #d6ecff; color: #0a4a80; border-radius: 2px; padding: 0 1px; }
      .field-picker-item { padding:5px 10px; font-size:12px; cursor:pointer; border-bottom:1px solid #eee; }
      .field-picker-item:hover { background:var(--gold-soft, #f7ecd5); }
    </style>

    <div class="form-actions" style="padding:12px;">
      <button class="btn btn-primary" type="submit">Save Template</button>
    </div>
  </form>

  <div class="applet-titlebar applet-titlebar-child"><span class="applet-title">Preview</span></div>
  <form method="GET" action="/admin/templates/<%= template.key %>/preview" target="_blank" style="padding:10px 12px;">
    <label style="font-size:12px;">Preview against a real <%= baseEntity.label %> record (enter its <%= baseEntity.pk %>):
      <input type="text" name="id" required style="margin-left:6px;">
    </label>
    <button class="btn btn-mini" type="submit">Preview HTML in New Tab</button>
  </form>
</div>

<script>
  function mlEscapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  // Highlights {{FieldName}} tags in gold and {{#each ...}}/{{/each}} loop
  // markers in blue, leaving everything else exactly as typed (still
  // HTML-escaped so the highlight layer never accidentally interprets the
  // template's own HTML as real markup).
  function mlRenderHighlight(text) {
    var escaped = mlEscapeHtml(text);
    escaped = escaped.replace(/\{\{(#each\s+[\w.]+|\/each)\}\}/g, '<span class="merge-tag-each">{{$1}}</span>');
    escaped = escaped.replace(/\{\{([\w.]+)\}\}/g, '<span class="merge-tag-highlight">{{$1}}</span>');
    return escaped + '\n'; // trailing newline keeps the last line's height matching the textarea's own
  }
  function mlUpdateHighlight() {
    var textarea = document.getElementById('htmlBodyEditor');
    var layer = document.getElementById('htmlBodyHighlight');
    layer.innerHTML = mlRenderHighlight(textarea.value);
  }
  function mlSyncScroll() {
    var textarea = document.getElementById('htmlBodyEditor');
    var layer = document.getElementById('htmlBodyHighlight');
    layer.scrollTop = textarea.scrollTop;
    layer.scrollLeft = textarea.scrollLeft;
  }

  function mlInsertMergeTag(tag) {
    var textarea = document.getElementById('htmlBodyEditor');
    var start = textarea.selectionStart;
    var end = textarea.selectionEnd;
    var text = textarea.value;
    textarea.value = text.substring(0, start) + tag + text.substring(end);
    textarea.focus();
    textarea.selectionStart = textarea.selectionEnd = start + tag.length;
    mlUpdateHighlight(); // programmatic value changes don't fire a native input event
  }
  function mlUpdateLineItemsFkOptions() {
    var parentSelect = document.getElementById('lineItemsChildTable');
    var fkSelect = document.getElementById('lineItemsFkField');
    var chosenParent = parentSelect.value;
    Array.from(fkSelect.options).forEach(function(opt) {
      if (!opt.value) { opt.style.display = ''; return; }
      opt.style.display = (opt.getAttribute('data-parent') === chosenParent) ? '' : 'none';
    });
    fkSelect.value = '';
  }
  mlUpdateLineItemsFkOptions();

  (function() {
    var textarea = document.getElementById('htmlBodyEditor');
    textarea.addEventListener('input', mlUpdateHighlight);
    textarea.addEventListener('scroll', mlSyncScroll);
    mlUpdateHighlight();
  })();
</script>

<%- include('../partials/foot') %>
