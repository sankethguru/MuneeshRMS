<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('_subnav', { sub: 'email' }) %>

<div class="applet-shell">
  <div class="applet-titlebar">
    <span class="applet-title">Email Settings</span>
  </div>

  <% if (error) { %><div class="admin-notice err"><%= error %></div><% } %>
  <% if (notice) { %><div class="admin-notice ok"><%= notice %></div><% } %>

  <p class="admin-help">
    Outbound email is sent over SMTP. Fill in your mail provider's details below (a Gmail app-password, your
    domain's SMTP, or an SES/SendGrid SMTP endpoint all work). The password is stored separately from the
    schema and is never included in a backup. <strong>Deliverability</strong> (SPF/DKIM/from-domain reputation)
    is configured with your mail provider, not here.
  </p>

  <form method="POST" action="/admin/email-settings" class="detail-form" style="max-width:640px;">
    <div class="field-grid">
      <div class="field-row"><label class="field-label">SMTP Host</label><div class="field-value"><input type="text" name="host" value="<%= settings.host || '' %>" placeholder="smtp.gmail.com"></div></div>
      <div class="field-row"><label class="field-label">Port</label><div class="field-value"><input type="number" name="port" value="<%= settings.port || 587 %>"></div></div>
      <div class="field-row"><label class="field-label">Use implicit TLS (port 465)</label><div class="field-value"><input type="checkbox" name="secure" <%= settings.secure ? 'checked' : '' %>> <span class="admin-hint">Leave off for STARTTLS on 587/25.</span></div></div>
      <div class="field-row"><label class="field-label">Username</label><div class="field-value"><input type="text" name="username" value="<%= settings.username || '' %>" placeholder="often your full email address"></div></div>
      <div class="field-row"><label class="field-label">Password</label><div class="field-value">
        <% if (passwordSource === 'env') { %>
          <span class="admin-hint">Set via the <code>SMTP_PASSWORD</code> environment variable &mdash; not editable here.</span>
        <% } else { %>
          <input type="password" name="password" placeholder="<%= hasPassword ? '\u2022\u2022\u2022\u2022\u2022\u2022 (leave blank to keep)' : 'enter SMTP password' %>">
          <% if (hasPassword) { %><label class="admin-hint"><input type="checkbox" name="clearPassword"> clear stored password</label><% } %>
        <% } %>
      </div></div>
      <div class="field-row"><label class="field-label">From Name</label><div class="field-value"><input type="text" name="fromName" value="<%= settings.fromName || '' %>" placeholder="Muneesh Legacy"></div></div>
      <div class="field-row"><label class="field-label">From Address</label><div class="field-value"><input type="text" name="fromAddress" value="<%= settings.fromAddress || '' %>" placeholder="billing@yourdomain.com"></div></div>
      <div class="field-row"><label class="field-label">Reply-To</label><div class="field-value"><input type="text" name="replyTo" value="<%= settings.replyTo || '' %>" placeholder="optional"></div></div>
      <div class="field-row"><label class="field-label">Notification channel</label><div class="field-value"><input type="checkbox" name="notifyChannel" <%= settings.notifyChannel ? 'checked' : '' %>> <span class="admin-hint">Also deliver enabled notification sources (reminders, bills, &hellip;) by email. Configure which sources in Admin &rarr; Notifications.</span></div></div>
      <div class="field-row"><label class="field-label">Notify email to</label><div class="field-value"><input type="text" name="notifyEmailTo" value="<%= settings.notifyEmailTo || '' %>" placeholder="you@example.com (comma-separate for several)"></div></div>
      <div class="field-row"><label class="field-label">Email log retention (days)</label><div class="field-value"><input type="number" name="logRetentionDays" value="<%= settings.logRetentionDays || 90 %>" min="1" style="width:100px;"> <span class="admin-hint">Email Log rows older than this are automatically purged.</span></div></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary" type="submit">Save Email Settings</button></div>
  </form>

  <hr style="margin:16px 0;">
  <form method="POST" action="/admin/email-settings/test" class="detail-form" style="max-width:640px;">
    <div class="field-grid">
      <div class="field-row"><label class="field-label">Send a test email to</label><div class="field-value"><input type="text" name="testTo" placeholder="you@example.com"></div></div>
    </div>
    <div class="form-actions"><button class="btn" type="submit" <%= configured ? '' : 'disabled' %>>Send Test Email</button>
      <% if (!configured) { %><span class="admin-hint">Set SMTP host + from-address first.</span><% } %>
    </div>
  </form>

  <hr style="margin:16px 0;">
  <p class="admin-help">
    <strong>Email templates</strong> (the emails you send from a record &mdash; e.g. an invoice to a tenant) are
    authored in <a href="/admin/templates">Admin &rarr; Templates</a> as templates of kind <em>Email</em>, bound to
    a table. Every record of that table then shows a send button per template. Delivery history is in the
    <a href="/email_log">Email Log</a>.
  </p>
  <% if (emailTemplates && emailTemplates.length) { %>
    <table class="list-table" style="max-width:640px;"><thead><tr><th>Email template</th><th>For table</th></tr></thead><tbody>
      <% emailTemplates.forEach(function(t){ %>
        <tr><td><a href="/admin/templates/<%= t.key %>/edit"><%= t.label %></a></td><td><%= entities[t.baseTable] ? entities[t.baseTable].label : t.baseTable %></td></tr>
      <% }); %>
    </tbody></table>
  <% } %>
</div>

<%- include('../partials/foot') %>
