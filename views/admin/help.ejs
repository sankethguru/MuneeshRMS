<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('_subnav', { sub: 'help' }) %>

<div class="applet-shell">
  <div class="applet-titlebar">
    <span class="applet-title">Help</span>
  </div>

  <div class="help-view-tabs">
    <a class="help-view-tab <%= view === 'formula-reference' ? '' : 'active' %>" href="/admin/help?view=getting-started">Getting Started</a>
    <a class="help-view-tab <%= view === 'formula-reference' ? 'active' : '' %>" href="/admin/help?view=formula-reference">Formula Language Reference</a>
  </div>
  <style>
    .help-view-tabs { display: flex; flex-wrap: wrap; }
    .help-view-tab {
      flex: 1;
      min-width: 180px;
      text-align: center;
      padding: 9px 12px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      color: #d8d2bf;
      background: linear-gradient(180deg, #565244 0%, #3f3c31 100%);
      border-bottom: 2px solid #8a7a4f;
    }
    .help-view-tab:hover { text-decoration: none; color: #f2ede0; }
    .help-view-tab.active {
      background: var(--gold-soft, #f7ecd5);
      color: var(--navy-2);
      border-bottom: 2px solid var(--gold);
    }
  </style>

  <% if (view === 'formula-reference') { %>
    <%- include('_help-formula') %>
  <% } else { %>
    <%- include('_help-journey') %>
  <% } %>
</div>

<%- include('../partials/foot') %>
