<div class="admin-subtabs reorderable-list" data-reorder-url="/admin/subnav/reorder">
  <% (adminSubnavOrder || []).forEach(function(key) { %>
    <% var fixedPage = adminSubnavFixedPages[key]; %>
    <% if (fixedPage) { %>
      <a class="admin-subtab <%= sub === key ? 'active' : '' %>" data-item-id="<%= key %>" href="<%= fixedPage.href %>"><%= fixedPage.label %></a>
    <% } else if (entities[key]) { %>
      <a class="admin-subtab <%= sub === ('table:' + key) ? 'active' : '' %>" data-item-id="<%= key %>" href="/<%= key %>"><%= entities[key].label %></a>
    <% } %>
  <% }); %>
</div>
